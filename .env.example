# RenoLab Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to Git.

# Database
DATABASE_URL=mysql://user:password@localhost:3306/renolab

# Server
NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_to_a_long_random_secret
OAUTH_SERVER_URL=

# CORS / API
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:3000

# Email (Resend SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_FROM=hello@renolab.co.uk

# Stripe - use test mode locally
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price_id
STRIPE_TRADE_PRICE_ID=price_your_trade_monthly_price_id
STRIPE_RENOVATION_PASS_PRICE_ID=price_your_renovation_pass_price_id

# OpenAI (for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Analytics
VITE_GA4_ID=G-76KNL8MVVT
VITE_META_PIXEL_ID=

# Admin / site
ADMIN_EMAIL=darrenkearney171@hotmail.co.uk
SITE_URL=https://renolab.co.uk
